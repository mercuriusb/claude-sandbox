#!/usr/bin/env bash
#
# swift-parse-check — Syntaxprüfung für Swift-Code, der sich im Container nicht typechecken lässt.
#
# `swiftc -typecheck` scheitert an jedem `import UIKit` / `AppKit` / `SwiftUI`: die Apple-SDKs
# gibt es hier nicht. `swiftc -parse` läuft dagegen durch — es prüft nur die Syntax und schaut
# sich keine Module an. Damit fallen Tippfehler, unbalancierte Klammern und kaputte Signaturen
# auf, bevor sie auf dem Mac auffallen.
#
# Was es NICHT prüft: Typen, Namen, Overloads, Verfügbarkeit — alles Semantik. Ein grüner Lauf
# heißt "syntaktisch wohlgeformt", nicht "übersetzt".
#
# Usage:
#     swift-parse-check                    # alle gegenüber HEAD geänderten .swift-Dateien
#     swift-parse-check Sources App/       # alle .swift-Dateien unterhalb der Pfade
#     swift-parse-check A.swift B.swift
set -uo pipefail

# Generierte und eingebundene Fremdquellen: nicht unser Code, oft zu neue oder zu alte Syntax.
readonly SKIP_RE='(^|/)(\.build|\.git|\.swiftpm|DerivedData|Pods|Carthage|checkouts)(/|$)'

die() { printf '\033[1;31mswift-parse-check:\033[0m %s\n' "$*" >&2; exit 2; }

command -v swiftc >/dev/null || die "swiftc nicht im PATH"

# --- Dateien einsammeln ---------------------------------------------------------------------
if [ "$#" -eq 0 ]; then
    top="$(git rev-parse --show-toplevel 2>/dev/null)" \
        || die "kein git-Repo — bitte Pfade angeben"
    # Geändert (ohne gelöschte) + unversioniert, immer vom Repo-Wurzelverzeichnis aus.
    mapfile -t candidates < <(
        {
            git -C "$top" diff --name-only --diff-filter=d HEAD
            git -C "$top" ls-files --others --exclude-standard
        } | sed "s|^|$top/|"
    )
    origin="geändert gegenüber HEAD"
else
    mapfile -t candidates < <(
        for p in "$@"; do
            [ -e "$p" ] || die "kein solcher Pfad: $p"
            if [ -d "$p" ]; then find "$p" -type f -name '*.swift'; else printf '%s\n' "$p"; fi
        done
    )
    origin="aus $# Pfad(en)"
fi

files=()
for f in "${candidates[@]}"; do
    case "$f" in *.swift) ;; *) continue ;; esac
    [[ "$f" =~ $SKIP_RE ]] && continue
    [ -f "$f" ] || continue
    files+=("$f")
done

if [ "${#files[@]}" -eq 0 ]; then
    printf 'Keine .swift-Dateien zu prüfen (%s).\n' "$origin"
    exit 0
fi

# --- prüfen ---------------------------------------------------------------------------------
printf '\033[1;34m==>\033[0m Parse %d Datei(en) (%s)\n' "${#files[@]}" "$origin"
if swiftc -parse "${files[@]}"; then
    printf '\033[1;32m==>\033[0m Syntax OK. (Typen und Namen prüft erst der Mac.)\n'
else
    status=$?
    printf '\033[1;31m==>\033[0m Syntaxfehler.\n' >&2
    exit "$status"
fi
